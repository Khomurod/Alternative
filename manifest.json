{
  "manifest_version": 3,
  "name": "DAT Dispatcher Assist Tool",
  "description": "Injects dispatcher workflow helpers into the DAT Freight & Analytics loadboard.",
  "version": "1.4.0",
  "action": {
    "default_title": "DAT Dispatcher Assist Tool — open Side Panel"
  },
  "permissions": [
    "storage",
    "identity",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "oauth2": {
    "client_id": "374181243903-fj3ktspdhkdt1ebp4oe9bpsmb4l7hbto.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "*://*.dat.com/*",
    "https://photon.komoot.io/*",
    "https://router.project-osrm.org/*",
    "https://nominatim.openstreetmap.org/*",
    "https://tile.openstreetmap.org/*",
    "https://maps.googleapis.com/*",
    "https://routes.googleapis.com/*",
    "https://apis.tollguru.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.dat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css",
        "leaflet-vendor.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "cities.json",
        "leaflet-images/*"
      ],
      "matches": [
        "*://*.dat.com/*"
      ]
    }
  ],
  "key": ""
}
